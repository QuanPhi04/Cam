<?xml version="1.0" encoding="utf-8"?>
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Chấm khi đang được chọn (Dài ra, màu Cam đậm) -->
    <item android:state_selected="true">
        <shape android:shape="rectangle">
            <solid android:color="@color/fruit_orange" />
            <corners android:radius="10dp" />
            <size android:width="20dp" android:height="8dp" />
        </shape>
    </item>

    <!-- Chấm mặc định (Tròn, màu Cam nhạt/Xám dịu) -->
    <item>
        <shape android:shape="oval">
            <solid android:color="#FFDAB9" /> <!-- Màu cam rất nhạt -->
            <size android:width="8dp" android:height="8dp" />
        </shape>
    </item>
</selector>