<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="24dp">

    <TextView
        android:id="@+id/tv_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="300dp"
        android:fontFamily="serif"
        android:text="Cam nên gọi bạn là gì nhỉ?......"
        android:textColor="@color/fruit_orange"
        android:textSize="22sp"
        android:textStyle="bold"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <EditText
        android:id="@+id/et_username"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:background="@null"
        android:fontFamily="serif"
        android:gravity="center"
        android:hint="Tên của bạn"
        android:inputType="textPersonName"
        android:textColor="@color/fruit_orange"
        android:textColorHint="@color/fruit_orange_light"
        android:textSize="18sp"
        app:layout_constraintTop_toBottomOf="@id/tv_title" />

    <View
        android:id="@+id/username_underline"
        android:layout_width="200dp"
        android:layout_height="1dp"
        android:background="@color/fruit_orange"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_username" />

    <TextView
        android:id="@+id/tv_auth_message"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginTop="24dp"
        android:fontFamily="serif"
        android:gravity="center"
        android:textColor="@color/fruit_green_dark"
        android:textSize="16sp"
        android:textStyle="bold"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/username_underline" />

    <EditText
        android:id="@+id/et_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@null"
        android:fontFamily="serif"
        android:gravity="center"
        android:hint="Mật khẩu"
        android:inputType="textPassword"
        android:textColor="@color/fruit_orange"
        android:textColorHint="@color/fruit_orange_light"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/tv_auth_message" />

    <View
        android:id="@+id/password_underline"
        android:layout_width="200dp"
        android:layout_height="1dp"
        android:background="@color/fruit_orange"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_password" />

    <EditText
        android:id="@+id/et_confirm_password"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="20dp"
        android:background="@null"
        android:fontFamily="serif"
        android:gravity="center"
        android:hint="Nhập lại mật khẩu"
        android:inputType="textPassword"
        android:textColor="@color/fruit_orange"
        android:textColorHint="@color/fruit_orange_light"
        android:textSize="18sp"
        android:visibility="gone"
        app:layout_constraintTop_toBottomOf="@id/password_underline" />

    <View
        android:id="@+id/confirm_password_underline"
        android:layout_width="200dp"
        android:layout_height="1dp"
        android:background="@color/fruit_orange"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/et_confirm_password" />

</androidx.constraintlayout.widget.ConstraintLayout>
